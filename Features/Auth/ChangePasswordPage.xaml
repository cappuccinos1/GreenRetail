<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Auth"
             x:Class="GreenRetail.Features.Auth.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Change password"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24">
        <VerticalStackLayout WidthRequest="360" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <Label Text="Set a new password" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Your temporary password must be replaced before you can use Green Retail." HorizontalTextAlignment="Center" />
            <Entry Placeholder="Current password" Text="{Binding CurrentPassword}" IsPassword="True" />
            <Entry Placeholder="New password" Text="{Binding NewPassword}" IsPassword="True" />
            <Entry Placeholder="Confirm new password" Text="{Binding ConfirmPassword}" IsPassword="True" />
            <Button Text="Save password" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
