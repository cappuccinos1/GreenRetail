<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Auth"
             x:Class="GreenRetail.Features.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid Padding="24">
        <VerticalStackLayout WidthRequest="340"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="Green Retail"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Username" />
            <Entry x:Name="UserNameEntry"
                   Text="{Binding UserName}"
                   Placeholder="Username"
                   ReturnType="Next"
                   Completed="OnUserNameCompleted"
                   Keyboard="Text" />

            <Label Text="Password" />
            <Entry x:Name="PasswordEntry"
                   Text="{Binding Password}"
                   Placeholder="Password"
                   ReturnType="Done"
                   Completed="OnPasswordCompleted"
                   IsPassword="True" />

            <Button Text="Login"
                    Command="{Binding LoginCommand}" />

            <Button Text="Reset test Owner access"
                    Command="{Binding ResetOwnerAccessCommand}"
                    IsVisible="{Binding IsDevelopmentRecoveryEnabled}"
                    BackgroundColor="#FEF3C7"
                    TextColor="#92400E" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
