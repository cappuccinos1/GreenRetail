<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Setup"
             x:Class="GreenRetail.Features.Setup.SetupPage"
             x:DataType="vm:SetupViewModel"
             Title="System Setup">
    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="16">
            <Label Text="System Setup" FontSize="28" FontAttributes="Bold" />
            <Label Text="Use this owner/admin screen to create the real business structure on a clean installation. Nothing is pre-seeded." TextColor="Gray" />

            <Border StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Create branch" FontSize="20" FontAttributes="Bold" />
                    <Entry Placeholder="Branch code (e.g. ABJ01)" Text="{Binding BranchCode}" />
                    <Entry Placeholder="Branch name" Text="{Binding BranchName}" />
                    <Button Text="Create Branch" Command="{Binding CreateBranchCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Create POS terminal" FontSize="20" FontAttributes="Bold" />
                    <Picker Title="Branch" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" ItemDisplayBinding="{Binding Name}" />
                    <Entry Placeholder="Terminal code (e.g. REG01)" Text="{Binding TerminalCode}" />
                    <Entry Placeholder="Terminal name" Text="{Binding TerminalName}" />
                    <Button Text="Create Terminal" Command="{Binding CreateTerminalCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
