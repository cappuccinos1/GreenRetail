<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Dashboard"
             x:Class="GreenRetail.Features.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="#F3F4F6"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="16">
            <Border BackgroundColor="#FFFFFF" Stroke="#E5E7EB" StrokeThickness="1" Padding="24">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="OPERATIONS CENTRE" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" />
                        <Label Text="{Binding Greeting}" FontSize="30" FontAttributes="Bold" TextColor="#111827" />
                        <Label Text="{Binding Role, StringFormat='Role: {0}'}" FontSize="15" TextColor="#6B7280" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="3">
                        <Label Text="GREENRETAIL" FontSize="12" FontAttributes="Bold" TextColor="#2563EB" HorizontalTextAlignment="End" />
                        <Label Text="Daily workspace" FontSize="13" TextColor="#6B7280" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#E5E7EB" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="AVAILABLE WORKSPACES" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" />
                    <Label Text="Your permissions determine which operational areas are available. The old tile wall has been replaced with a compact dashboard list." FontSize="14" TextColor="#4B5563" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tiles}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardTile">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,10" ColumnSpacing="14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#6B7280" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Open →" Command="{Binding BindingContext.NavigateToWorkspaceCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}}" CommandParameter="{Binding .}" BackgroundColor="White" TextColor="#2563EB" BorderColor="#BFDBFE" BorderWidth="1" CornerRadius="7" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding EmptyStateMessage}" TextColor="#B45309" FontSize="13" IsVisible="{Binding EmptyStateMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding InitializationError}" TextColor="#B91C1C" FontSize="13" IsVisible="{Binding InitializationError, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
