<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.CashSessions"
             x:Class="GreenRetail.Features.CashSessions.CashSessionPage"
             x:DataType="vm:CashSessionViewModel"
             Title="Cash Session">

    <ScrollView>
        <VerticalStackLayout Padding="24" WidthRequest="520" HorizontalOptions="Center" Spacing="14">
            <Label Text="Cash Session" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding SessionActionText}" FontSize="16" HorizontalTextAlignment="Center" />
            <Label Text="{Binding StatusMessage}" TextColor="Gray" HorizontalTextAlignment="Center" />

            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Open register" FontAttributes="Bold" />
                    <Entry Text="{Binding OpeningCashText}" Keyboard="Numeric" Placeholder="Opening cash (₦)" />
                    <Button Text="Open Cash Session" Command="{Binding OpenSessionCommand}"
                            IsVisible="{Binding IsSessionOpen, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Close / blind count" FontAttributes="Bold" />
                    <Label Text="The expected cash amount is deliberately not shown to the counter." FontSize="13" TextColor="Gray" />

                    <Button Text="Send to Accounts for Blind Count"
                            Command="{Binding CloseSessionCommand}"
                            IsVisible="{Binding IsNotCounting}" />

                    <Entry Text="{Binding CountedCashText}"
                           Keyboard="Numeric"
                           Placeholder="Accounts: enter counted cash (₦)"
                           IsVisible="{Binding IsCounting}" />

                    <Button Text="Record Blind Count"
                            Command="{Binding CloseSessionCommand}"
                            IsVisible="{Binding IsCounting}" />

                    <Button Text="Approve Variance &amp; Close"
                            Command="{Binding ApproveVarianceCommand}"
                            IsVisible="{Binding CanApproveVariance}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
