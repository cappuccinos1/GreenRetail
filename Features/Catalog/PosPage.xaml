<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Catalog"
             xmlns:cart="clr-namespace:GreenRetail.Features.Cart"
             x:Class="GreenRetail.Features.Catalog.PosPage"
             x:Name="RootPage"
             x:DataType="vm:PosViewModel"
             Title="POS">

    <Grid Padding="12"
          RowDefinitions="Auto,Auto,*">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="8">

            <Label Text="{Binding CurrentUserName, StringFormat='User: {0}'}"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   TextColor="Gray"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Refresh"
                    Command="{Binding SearchCommand}" />

            <Button Grid.Column="3"
                    Text="Logout"
                    Command="{Binding LogoutCommand}" />
        </Grid>

        <SearchBar Grid.Row="1"
                   Margin="0,10,0,0"
                   Placeholder="Scan barcode or search product"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" />

        <Grid Grid.Row="2"
              Margin="0,10,0,0"
              ColumnDefinitions="2*,*"
              ColumnSpacing="12">

            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No products found."
                               FontSize="18" />

                        <Button Text="Search Again"
                                Command="{Binding BindingContext.SearchCommand, Source={x:Reference RootPage}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductSummary">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Padding="6"
                              ColumnSpacing="8">

                            <Label Text="{Binding Name}"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="{Binding SellingPrice}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />

                            <Button Grid.Column="2"
                                    Text="Add"
                                    Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*,Auto,Auto"
                  RowSpacing="8">

                <Label Text="Cart"
                       FontSize="20"
                       FontAttributes="Bold" />

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Cart.Lines}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="Cart is empty."
                                   FontSize="18" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="cart:CartLine">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  Padding="4">
                                <Label Text="{Binding Name}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Quantity}"
                                       Margin="10,0" />
                                <Label Grid.Column="2"
                                       Text="{Binding LineTotal}"
                                       HorizontalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Grid.Row="2"
                       Text="{Binding Cart.Subtotal}"
                       FontSize="24"
                       FontAttributes="Bold" />

                <Button Grid.Row="3"
                        Text="Checkout"
                        Command="{Binding CheckoutCommand}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>