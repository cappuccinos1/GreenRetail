<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GreenRetail.Features.Hubs.InventoryHubPage" Title="Inventory" BackgroundColor="#F3F4F6">
    <ScrollView><VerticalStackLayout Padding="28" Spacing="18">
        <Label Text="Inventory" FontSize="32" FontAttributes="Bold" TextColor="#111827" />
        <Label Text="Catalog, stock control, suppliers, adjustments and transfers" FontSize="16" TextColor="#6B7280" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
            <Button Text="Inventory Operations" Clicked="OnInventoryClicked" HeightRequest="90" />
            <Button Grid.Column="1" Text="Purchasing / Suppliers" Clicked="OnPurchasingClicked" HeightRequest="90" />
            <Button Grid.Row="1" Text="Transfers" Clicked="OnInventoryClicked" HeightRequest="90" />
            <Button Grid.Row="1" Grid.Column="1" Text="Quarantine &amp; Adjustments" Clicked="OnInventoryClicked" HeightRequest="90" />
        </Grid>
        <Border BackgroundColor="White" Stroke="#E5E7EB" Padding="18"><Label Text="Inventory is the stock-posting authority. Quality Control stages accepted goods; inventory posts the accepted GRN into stock." TextColor="#6B7280" /></Border>
    </VerticalStackLayout></ScrollView>
</ContentPage>
