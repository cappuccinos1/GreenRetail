<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Features.Register"
             xmlns:cart="clr-namespace:GreenRetail.Features.Cart"
             xmlns:catalog="clr-namespace:GreenRetail.Features.Catalog"
             x:Class="GreenRetail.Features.Register.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Top Bar with Session Status -->
        <Grid Grid.Row="0" BackgroundColor="#1F2937" Padding="15" ColumnDefinitions="Auto, *, Auto">
            <Button Text="← Hub" Command="{Binding BackToHubCommand}" BackgroundColor="#374151" TextColor="White"/>
            <Label Grid.Column="1" Text="{Binding SessionStatusText}" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Label Grid.Column="2" Text="{Binding StatusMessage}" TextColor="#10B981" VerticalOptions="Center"/>
        </Grid>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 400" ColumnSpacing="0" IsEnabled="{Binding IsSessionOpen}">
            <!-- Left: Scan & Search -->
            <Grid Grid.Column="0" Padding="20" RowDefinitions="Auto, *">
                <Entry Grid.Row="0" Text="{Binding BarcodeInput}" Placeholder="Scan barcode or search..." FontSize="24" HeightRequest="60" BackgroundColor="#F3F4F6"/>
                <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" Margin="0,20,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ProductSummary">
                            <Grid ColumnDefinitions="*, Auto" Padding="10" BackgroundColor="White" Margin="0,0,0,5">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.AddToCartCommand, Source={RelativeSource AncestorType={x:Type vm:RegisterViewModel}}}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="18" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding SellingPrice}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Right: Ticket / Cart -->
            <Grid Grid.Column="1" BackgroundColor="#F9FAFB" Padding="20" RowDefinitions="Auto, *, Auto">
                <Label Text="CURRENT TICKET" FontAttributes="Bold" FontSize="18" TextColor="#6B7280"/>
                <CollectionView Grid.Row="1" ItemsSource="{Binding Cart.Lines}" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="cart:CartLine">
                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="5" Margin="0,0,0,5">
                                <Label Text="{Binding Name}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" Margin="10,0" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding LineTotal}" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <BoxView HeightRequest="1" Color="#E5E7EB"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="SUBTOTAL" FontSize="20"/>
                        <Label Grid.Column="1" Text="{Binding Cart.Subtotal}" FontSize="20" FontAttributes="Bold"/>
                    </Grid>
                    <Button Text="PAY (F12)" Command="{Binding OpenPaymentModalCommand}" BackgroundColor="#10B981" TextColor="White" FontSize="20" HeightRequest="60" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Session Open Overlay (Shows if Session is Closed) -->
        <Grid Grid.RowSpan="3" BackgroundColor="#E0000000" IsVisible="{Binding IsSessionOpen, Converter={StaticResource InvertedBoolConverter}}">
            <Border BackgroundColor="White" Padding="30" WidthRequest="400" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Register Closed" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#EF4444"/>
                    <Label Text="Opening Cash (Naira)" FontSize="16"/>
                    <Entry Text="{Binding OpeningCashText}" Keyboard="Numeric" FontSize="20" Placeholder="e.g. 50000"/>
                    <Button Text="Open Session" Command="{Binding OpenSessionCommand}" BackgroundColor="#10B981" TextColor="White" HeightRequest="50" FontAttributes="Bold"/>
                    <Label Text="*Only Managers can open sessions" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Payment Modal Overlay -->
        <Grid Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="{Binding IsPaymentModalVisible}">
            <Border BackgroundColor="White" Padding="30" WidthRequest="400" HeightRequest="500" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="COMPLETE SALE" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Cart.Subtotal, StringFormat='Total Due: {0}'}" FontSize="20" HorizontalOptions="Center"/>
                    <Entry Placeholder="Tendered Amount" Keyboard="Numeric" FontSize="24" HorizontalTextAlignment="Center"/>
                    <Button Text="CONFIRM CASH" Command="{Binding CompleteSaleCommand}" BackgroundColor="#10B981" TextColor="White" HeightRequest="60" FontAttributes="Bold"/>
                    <Button Text="Cancel" Command="{Binding ClosePaymentModalCommand}" BackgroundColor="Transparent" TextColor="#EF4444"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>