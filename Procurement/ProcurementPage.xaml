<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Procurement"
             xmlns:catalog="clr-namespace:GreenRetail.Features.Catalog"
             x:Class="GreenRetail.Procurement.ProcurementPage"
             x:DataType="vm:ProcurementViewModel"
             Title="Purchasing — Purchase Orders">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <Label Text="Purchasing is for purchase orders. Receiving and Quality Control are handled in the separate Receiving &amp; Quality Control workspace." TextColor="#6B7280" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="Gray" />

            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Product Search"
                           FontAttributes="Bold" />

                    <Entry Text="{Binding ProductSearchText}"
                           Placeholder="Search product" />

                    <Button Text="Search Products"
                            Command="{Binding SearchProductsCommand}" />

                    <CollectionView ItemsSource="{Binding Products}"
                                    SelectedItem="{Binding SelectedProduct}"
                                    SelectionMode="Single"
                                    HeightRequest="160">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="catalog:ProductSummary">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="4">
                                    <Label Text="{Binding Name}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Sku}"
                                           Margin="8,0" />
                                    <Label Grid.Column="2"
                                           Text="{Binding SellingPrice}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="{Binding SelectedProductText}"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>



            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create Purchase Order"
                           FontAttributes="Bold" />

                    <Entry Text="{Binding PoQuantityText}"
                           Placeholder="Quantity"
                           Keyboard="Numeric" />

                    <Entry Text="{Binding PoUnitCostText}"
                           Placeholder="Unit cost"
                           Keyboard="Numeric" />

                    <Button Text="Add PO Line"
                            Command="{Binding AddPurchaseOrderLineCommand}" />

                    <CollectionView ItemsSource="{Binding PurchaseOrderLines}"
                                    SelectionMode="None"
                                    HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NewPurchaseOrderLineItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="4">
                                    <Label Text="{Binding ProductName}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Quantity}"
                                           Margin="8,0" />
                                    <Label Grid.Column="2"
                                           Text="{Binding UnitCost}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Entry Text="{Binding PoNotes}"
                           Placeholder="PO notes" />

                    <Button Text="Create Purchase Order"
                            Command="{Binding CreatePurchaseOrderCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Active Purchase Orders"
                           FontAttributes="Bold" />

                    <Button Text="Refresh Purchase Orders"
                            Command="{Binding RefreshActivePurchaseOrdersCommand}" />

                    <CollectionView ItemsSource="{Binding ActivePurchaseOrders}"
                                    SelectedItem="{Binding SelectedPurchaseOrder}"
                                    SelectionMode="Single"
                                    HeightRequest="140">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PurchaseOrderListItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="4">
                                    <Label Text="{Binding Number}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding SupplierName}"
                                           Margin="8,0" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Total}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="{Binding SelectedPurchaseOrderText}"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Frame>



        </VerticalStackLayout>
    </ScrollView>
</ContentPage>