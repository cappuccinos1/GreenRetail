<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GreenRetail.Rbac"
             x:Class="GreenRetail.Rbac.RbacExplorerPage"
             x:DataType="vm:RbacExplorerViewModel"
             Title="RBAC Explorer">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <Label Text="{Binding StatusMessage}"
                   TextColor="Gray" />

            <Button Text="Refresh RBAC Data"
                    Command="{Binding RefreshCommand}" />

            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Roles"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding Roles}"
                                    SelectionMode="None"
                                    HeightRequest="160">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoleListItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="4">
                                    <Label Text="{Binding Name}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding PermissionCount}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Permissions"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding Permissions}"
                                    SelectionMode="None"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionListItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="4">
                                    <Label Text="{Binding Code}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Module}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Current User Permissions"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding UserPermissions}"
                                    SelectionMode="None"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserPermissionCheckItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="4">
                                    <Label Text="{Binding Code}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Granted}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>